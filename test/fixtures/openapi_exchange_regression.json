{
  "openapi": "3.0.3",
  "info": {
    "title": "Exchange regression API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.test"
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "summary": "List users",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/session": {
      "post": {
        "summary": "Create session",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "example": {
                "email": "mary@example.test",
                "scope": "read"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Created"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object"
      }
    }
  }
}
